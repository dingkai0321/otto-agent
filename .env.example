# Otto configuration template
# Copy this file to .env, choose one provider, and fill only the matching key.

OTTO_PROVIDER=anthropic

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
OPENCODE_ZEN_API_KEY=
OPENCODE_GO_API_KEY=

# Optional provider overrides
OTTO_API_KEY=
OTTO_BASE_URL=
OTTO_MODEL=
OTTO_SMALL_MODEL=
OTTO_LLM_TIMEOUT=

# Local state and PostgreSQL + pgvector
OTTO_HOME=
OTTO_WORKSPACE=
OTTO_DATABASE_URL=
OTTO_DATABASE_SCHEMA=
OTTO_EMBEDDING_MODEL=
OTTO_EMBEDDING_DIMENSIONS=
OTTO_EMBEDDING_API_KEY=
OTTO_EMBEDDING_BASE_URL=

# Agent loop, memory, context compaction, and permissions
OTTO_MAX_ITERATIONS=
OTTO_MAX_TOKENS=
OTTO_HISTORY_TURNS=
OTTO_CONSOLIDATE_EVERY=
OTTO_RETRIEVAL_TOP_K=
OTTO_CONTEXT_WINDOW_TOKENS=
OTTO_COMPACT_BUFFER_TOKENS=
OTTO_TOOL_RESULT_BUDGET_CHARS=
OTTO_COMPACT_KEEP_TOOL_RESULTS=
OTTO_COMPACT_KEEP_MESSAGES=
OTTO_COMPACT_MAX_MESSAGES=
OTTO_COMPACT_SUMMARY_MAX_TOKENS=
OTTO_COMPACT_MAX_FAILURES=
OTTO_SKILL_REINJECT_BUDGET_CHARS=
OTTO_PERMISSION_TIMEOUT=

# Optional capabilities
OTTO_EXPERIMENTAL=
OTTO_GRAPH_WORKFLOWS=
OTTO_DELEGATE_TIMEOUT=
OTTO_APPLE_CALENDAR=
OTTO_APPLE_CALENDARS=
OTTO_APPLE_TOOLS=
OTTO_GOOGLE_CALENDAR=
OTTO_GOOGLE_CALENDAR_ID=
OTTO_GH_TOOL=
OTTO_GH_REPO=
TAVILY_API_KEY=

# Voice
OTTO_WAKE_WORD=
OTTO_WAKE_ACK=
OTTO_FOLLOWUP_SECONDS=
OTTO_WHISPER_MODEL=
OTTO_WHISPER_LANG=
OTTO_TTS=
OTTO_VOICE=
OTTO_MIC_THRESHOLD=

# Optional gateways
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER=
DISCORD_ALLOWED_CHANNEL=
DISCORD_REQUIRE_MENTION=
DISCORD_MAX_TURNS_PER_HOUR=
DISCORD_HOME=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ALLOWED_PHONE=

# Optional integrations and operations
NOTION_TOKEN=
NOTION_EPISODES_DATABASE_ID=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTTO_DASHBOARD_PORT=
OTTO_EDITOR=
OTTO_EPISODIC_STORE=
OTTO_SESSION_IDLE_MINUTES=
